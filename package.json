{
  "name": "hook-toolkit",
  "version": "0.2.4",
  "description": "Production-ready React hooks that eliminate entire repetitive workflows — autosave, async actions, debounced search, persistent state, and unsaved-changes guards — not just another grab-bag of primitives.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "prepublishOnly": "npm run check"
  },
  "keywords": [
    "react",
    "hooks",
    "react-hooks",
    "custom-hooks",
    "typescript",
    "ssr",
    "autosave",
    "debounce",
    "debounced-search",
    "async",
    "async-action",
    "localstorage",
    "persistent-state",
    "unsaved-changes",
    "use-fetch",
    "fetch",
    "data-fetching",
    "mutation",
    "polling",
    "websocket",
    "infinite-scroll",
    "retry",
    "query",
    "invalidate-queries",
    "cache",
    "interval",
    "timeout",
    "clipboard",
    "click-outside",
    "hotkey",
    "hotkeys",
    "keyboard-shortcut",
    "keyboard-shortcuts",
    "keypress",
    "keybinding",
    "use-hotkey",
    "media-query",
    "network-status",
    "disclosure",
    "modal",
    "toggle",
    "counter",
    "document-title",
    "window-size",
    "event-listener",
    "previous",
    "use-previous",
    "is-mounted",
    "tanstack-query",
    "react-query",
    "react-query-hooks",
    "react-query-custom-hooks",
    "react-query-utils",
    "react-query-helpers",
    "react-query-utilities",
    "react-query-toolkit",
    "invalidate-queries",
    "query-invalidation",
    "query-cache"
  ],
  "author": "Rajkumar Rathod",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rajkumar4041/react-hooks.git"
  },
  "bugs": {
    "url": "https://github.com/rajkumar4041/react-hooks/issues"
  },
  "homepage": "https://hook-toolkit-document-8azd.vercel.app/",
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^5.1.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.4.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
